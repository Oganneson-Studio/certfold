FROM golang:1.26-alpine AS builder
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -o /out/sigils ./cmd/sigils

FROM alpine:3.20
RUN apk add --no-cache curl ca-certificates
# Under Docker on Linux the e2e runs the container as the host's user, who
# must be able to create the IPC socket in its default directory and
# server.data_dir in /var/lib/sigils, which sigils creates private.
RUN mkdir -p /var/run/sigil /var/lib/sigils && chmod 1777 /var/run/sigil /var/lib/sigils
COPY --from=builder /out/sigils /usr/local/bin/sigils
EXPOSE 18443
ENTRYPOINT ["sigils", "serve"]
