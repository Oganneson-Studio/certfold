FROM golang:1.26-alpine AS builder
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -o /out/sigilc ./cmd/sigilc

FROM alpine:3.20
RUN apk add --no-cache curl ca-certificates
COPY --from=builder /out/sigilc /usr/local/bin/sigilc
ENTRYPOINT ["sigilc", "serve"]
